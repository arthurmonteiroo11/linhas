---
import Base from '../layouts/Base.astro';
import LineMap from '../components/LineMap.astro';
import TourControl from '../components/TourControl.astro';
import Curiosidades from '../components/Curiosidades.astro';
import linhas from '../data/linhas.json';

const formatDate = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <header class="hero">
    <p class="hero__kicker data">São Paulo · 1974 — 2026</p>
    <h1 class="hero__title">Linhas</h1>
    <div class="hero__stripe" aria-hidden="true">
      {linhas.map((l) => <span style={`--line: ${l.cor}`}></span>)}
    </div>
    <p class="hero__lede">
      Em 1974, sete estações. Hoje, uma rede que carrega milhões de pessoas por dia.
      Esta é a história de como ela foi desenhada, um traço por vez.
    </p>
    <span class="hero__hint data" aria-hidden="true">role ↓</span>
  </header>

  <section class="story">
    <div class="story__map">
      <LineMap />
    </div>

    <ol class="story__chapters">
      {linhas.map((l) => (
        <li
          class="chapter"
          data-line={l.id}
          data-year={l.ano}
          data-color={l.cor}
          data-vehicle={l.tipo}
          data-label={`Linha ${l.nome}`}
          style={`--line: ${l.cor}`}
        >
          <p class="chapter__meta data">
            <span class="chapter__badge">{l.numero}</span>
            {formatDate(l.data)}
          </p>
          <h2 class="chapter__title">Linha {l.nome}</h2>
          <span class="chapter__rule" aria-hidden="true"></span>
          <p class="chapter__route data">{l.trecho}</p>
          <p class="chapter__text">{l.resumo}</p>
        </li>
      ))}
    </ol>
  </section>

  <Curiosidades />

  <footer class="outro">
    <p class="outro__kicker data">Fim da linha</p>
    <p class="outro__title">Obrigado por viajar com a gente.</p>
    <p class="data">Feito por Arthur Monteiro · dados de fontes públicas, citadas no README</p>
  </footer>

  <TourControl />
</Base>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-content: end;
    gap: var(--space-m);
    padding: var(--gutter);
    padding-bottom: calc(var(--space-l) + 7rem);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .hero__kicker { color: var(--ink-soft); }
  .hero__title {
    --wdth: 62;
    font-size: var(--step-5);
    font-variation-settings: 'wdth' var(--wdth), 'wght' 850;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__stripe {
    display: flex;
    width: min(100%, 40rem);
    height: 14px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .hero__stripe span {
    flex: 1;
    background: var(--line);
    transform-origin: left;
  }
  .hero__lede { font-size: var(--step-1); max-width: 34ch; }
  .hero__hint {
    color: var(--ink-soft);
    animation: hint-bob 1.1s var(--ease-in-out) infinite alternate;
  }
  @keyframes hint-bob {
    to { translate: 0 5px; }
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-inline: var(--gutter);
  }
  .story__map {
    position: sticky;
    top: 0;
    z-index: 1;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-s) var(--gutter);
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .story__chapters { list-style: none; padding: 0; }
  .chapter {
    min-height: 75svh;
    display: grid;
    align-content: start;
    gap: var(--space-s);
    padding-block: var(--space-l);
    border-top: 1px solid var(--rule);
  }
  .chapter__meta { display: flex; align-items: center; gap: 0.6rem; color: var(--ink-soft); }
  .chapter__badge {
    display: inline-grid;
    place-items: center;
    width: 2rem; height: 2rem;
    border-radius: 50%;
    background: var(--line);
    color: var(--paper);
    font-weight: 500;
  }
  .chapter__title {
    font-size: var(--step-3);
    font-variation-settings: 'wdth' 75, 'wght' 750;
  }
  .chapter__rule {
    width: 4.5rem;
    height: 6px;
    background: var(--line);
    box-shadow: 3px 3px 0 var(--ink);
    transform-origin: left;
  }
  .chapter__route { color: color-mix(in oklab, var(--line) 50%, var(--ink)); }

  .outro {
    min-height: 60svh;
    display: grid;
    align-content: center;
    gap: var(--space-s);
    padding: var(--space-l) var(--gutter) calc(var(--space-l) + 7.5rem);
    color: var(--ink-soft);
    border-top: 2px solid var(--ink);
  }
  .outro__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-variation-settings: 'wdth' 70, 'wght' 800;
    line-height: 0.95;
    color: var(--ink);
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .story { grid-template-columns: 1fr 1fr; gap: var(--space-l); }
    .story__map {
      height: 100svh;
      margin-inline: 0;
      padding: 0;
      display: grid;
      align-items: center;
      background: none;
      border-bottom: 0;
    }
    .chapter { min-height: 80svh; align-content: center; }
  }
</style>

<script>
  import { initMotion } from '../scripts/motion.js';
  import { initStationHover } from '../scripts/station-hover.js';
  import { initTour } from '../scripts/tour.js';

  const animate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  initTour(initMotion());
  initStationHover({ animate });

  const loadBackdrop = () =>
    import('../scripts/backdrop.js').then(({ initBackdrop }) => initBackdrop({ animate }));

  if ('requestIdleCallback' in window) requestIdleCallback(loadBackdrop, { timeout: 1500 });
  else setTimeout(loadBackdrop, 400);
</script>