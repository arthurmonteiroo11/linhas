---
import linhas from '../data/linhas.json';
import mapa from '../data/mapa.json';
---
<figure class="map" aria-label="Mapa esquemático das linhas do metrô">
  <svg viewBox="0 0 600 600" role="img">
    <title>Rede do metrô ao longo do tempo</title>
    {linhas.map((l) => (
      <g class="map__group" data-line={l.id}>
        <path class="map__shadow" d={mapa[l.id].d} pathLength="1" />
        <path class="map__line" d={mapa[l.id].d} stroke={l.cor} pathLength="1" />
      </g>
    ))}
    {linhas.map((l) => (
      <g class="map__stations" data-line={l.id}>
        {mapa[l.id].estacoes.map((e) => (
          <circle
            class:list={['map__station', { 'map__station--hub': e.integracao }]}
            cx={e.x}
            cy={e.y}
            r={e.integracao ? 9 : 5.5}
          >
            <title>{e.nome}</title>
          </circle>
        ))}
      </g>
    ))}
  </svg>
  <figcaption class="map__year data" aria-live="polite">1974</figcaption>
</figure>

<style>
  .map { position: relative; width: 100%; aspect-ratio: 1; }
  .map svg { overflow: visible; }

  .map__line,
  .map__shadow {
    fill: none;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .map__shadow {
    stroke: var(--ink);
    transform: translate(4px, 4px);
  }

  .map__station {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 3;
  }
  .map__station--hub { stroke-width: 3.5; }

  .map__year {
    position: absolute;
    right: 0; bottom: 0;
    font-size: var(--step-3);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 70, 'wght' 800;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .map__line, .map__shadow { stroke-dashoffset: 0; }
  }
</style>