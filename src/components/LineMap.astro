---
import linhas from '../data/linhas.json';
import mapa from '../data/mapa.json';
---
<figure class="map" aria-label="Mapa esquemático das linhas do metrô">
  <svg viewBox="0 0 600 600" role="img">
    <title>Rede do metrô ao longo do tempo</title>
    <desc>Mapa esquemático com as linhas Azul, Vermelha, Verde, Lilás, Amarela, Prata, Ouro e Laranja, que aparecem na ordem em que foram inauguradas.</desc>
    {linhas.map((l) => (
      <g class="map__group" data-line={l.id}>
        <path class="map__shadow" d={mapa[l.id].d} />
        <path class="map__line" d={mapa[l.id].d} stroke={l.cor} />
      </g>
    ))}
    {linhas.map((l) => (
      <g class="map__stations" data-line={l.id} data-color={l.cor}>
        {mapa[l.id].estacoes.map((e) => (
          <circle
            class:list={['map__station', { 'map__station--hub': e.integracao }]}
            cx={e.x}
            cy={e.y}
            r={e.integracao ? 9 : 5.5}
            data-name={e.nome}
          />
        ))}
      </g>
    ))}
    {linhas.map((l) => (
      <g class="map__labels" data-line={l.id} aria-hidden="true">
        {mapa[l.id].estacoes.filter((e) => e.rotulo).map((e) => (
          <text
            class="map__label"
            x={e.x + e.rotulo.dx}
            y={e.y + e.rotulo.dy}
            text-anchor={e.rotulo.ancora}
          >
            {e.rotulo.texto ?? e.nome}
          </text>
        ))}
      </g>
    ))}
  </svg>
  <figcaption class="map__year data" aria-hidden="true">1974</figcaption>
  <p class="map__tip data" aria-hidden="true"></p>
</figure>

<style>
  .map {
    position: relative;
    width: min(100%, 38svh);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .map { width: 100%; }
  }
  .map svg { overflow: visible; }

  .map__line,
  .map__shadow {
    fill: none;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map__shadow {
    stroke: var(--ink);
    transform: translate(4px, 4px);
  }

  .map__station {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 3;
  }
  .map__station--hub { stroke-width: 3.5; }

  .map__label {
    display: none;
    font-family: var(--font-data);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  @media (min-width: 900px) {
    .map__label { display: inline; }
  }

  .map__tip {
    --tip-color: var(--ink);
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.3rem 0.55rem;
    color: var(--paper);
    background: var(--ink);
    box-shadow: 3px 3px 0 var(--tip-color);
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 16px));
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .map__tip.is-visible { opacity: 1; }

  .map__year {
    position: absolute;
    right: 0; bottom: 0;
    font-size: var(--step-3);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 70, 'wght' 800;
    color: var(--ink);
  }
</style>
