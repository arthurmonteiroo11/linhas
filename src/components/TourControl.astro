  .tour[data-state='playing'] .tour__rail { animation: rail-pass 0.22s linear infinite; }
  .tour[data-state='playing'] .tour__beam { animation: beam-pass 0.55s linear infinite; }
  .tour[data-state='playing'] .tour__car { animation: car-sway 0.9s var(--ease-in-out) infinite alternate; }
  .tour.is-switching .tour__car { animation: car-hop 420ms var(--ease-press); }

  @keyframes wheel-spin { to { rotate: 360deg; } }
  @keyframes rail-pass { to { background-position: -14px 0; } }
  @keyframes beam-pass { to { background-position: -48px 0; } }
  @keyframes car-sway { to { translate: 0 1px; } }
  @keyframes car-hop {
    40% { translate: 0 -7px; }
    100% { translate: 0 0; }
  }
</style>