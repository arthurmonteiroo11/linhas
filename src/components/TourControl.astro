    left: 0;
    right: 0;
    top: 10px;
    height: 7px;
    border-top: 3px solid var(--ink);
    background: repeating-linear-gradient(90deg, var(--ink) 0 4px, transparent 4px 14px);
    background-size: 14px 100%;
  }

  .tour__beam {
