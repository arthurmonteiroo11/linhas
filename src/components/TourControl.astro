    display: flex;
    gap: 6px;
    padding-top: 4px;
  }
  .tour__windows i {
    flex: 1;
    height: 10px;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 2px;
  }
  .tour__windows i:last-child {
    flex: 0 0 2.2rem;
    border-radius: 2px 14px 2px 2px;
  }

  .tour__next {
    grid-area: sign;
    min-width: 0;
    padding: 0.45rem 0.5rem;
    color: var(--led);
    background: var(--ink);
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 0 6px color-mix(in oklab, var(--led) 60%, transparent);
  }

  .tour__actions {
    grid-area: actions;
    display: flex;
    gap: 0.4rem;
  }

  .tour__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.6rem;
    padding-inline: 0.9rem;
    font: 600 var(--step--1) / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 3px;
