<style>
  .tour {
    --tour-color: var(--ink);
    --led: #f4b23e;
    --concrete: #a3a7ab;
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 10;
    translate: -50% 0;
    width: min(30rem, calc(100% - 2rem));
  }
  .tour[hidden] { display: none; }

  .tour__car {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'windows windows'
      'sign actions';
    align-items: center;
    gap: 0.45rem 0.6rem;
    padding: 0.6rem 1.1rem 0.6rem 0.8rem;
    background: var(--tour-color);
    border: 2px solid var(--ink);
    border-radius: 6px 34px 10px 6px;
    box-shadow: 4px 4px 0 var(--ink);
    overflow: hidden;
    transition: background-color var(--dur-med) var(--ease-out);
  }

  .tour__progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: color-mix(in oklab, var(--ink) 35%, transparent);
  }
  .tour__bar {
    display: block;
    height: 100%;
    background: var(--paper);
    transform-origin: left;
    transform: scaleX(0);
  }

  .tour__windows {
